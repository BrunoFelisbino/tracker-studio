{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tracker-studio/suntech_capabilities.schema.json",
  "title": "Suntech Capabilities Catalog",
  "description": "Schema for Suntech device capabilities extracted from official manuals",
  "type": "object",
  "required": ["version", "generatedAt", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string"},
    "generatedAt": {"type": "string"},
    "source": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "#/definitions/capability"}
    }
  },
  "definitions": {
    "capability": {
      "type": "object",
      "required": ["id", "name", "category", "description", "manual", "models", "commandSyntaxStatus", "channels", "risk"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["network", "apn", "server", "dns", "communication", "gps", "agps", "ignition", "inputs", "outputs", "power", "battery", "times", "events", "alerts", "geofence", "sensors", "sleep", "jammer", "odometer", "position", "maintenance", "firmware", "diagnostic", "security", "sms", "gprs", "usb_serial"]},
        "description": {"type": "string", "minLength": 1},
        "manual": {"type": "string"},
        "models": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "rawCommand": {"type": "string"},
        "commandSyntaxStatus": {"type": "string", "enum": ["documented", "undocumented", "partially_documented"]},
        "parameters": {"type": "array", "items": {"$ref": "#/definitions/parameter"}},
        "channels": {"type": "array", "items": {"type": "string", "enum": ["usb", "serial", "sms", "gprs"]}, "minItems": 1},
        "risk": {"type": "string", "enum": ["read", "config", "action", "destructive"]},
        "notes": {"type": "string"}
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "group": {"type": "string"},
        "param": {"type": "string"},
        "value": {"type": "string"},
        "values": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"}
      }
    }
  }
}
